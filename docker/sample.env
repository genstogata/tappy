# Copy this file to `.env` (same directory as docker-compose.tunnel-example.yml)
# and fill in your tunnel token:
#
#   cp sample.env .env
#
# Docker Compose automatically reads `.env` from the directory containing the
# compose file, which is what makes ${TUNNEL_TOKEN} in the compose file resolve.
#
# Get the token from:
#   Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> your tunnel
#   -> "Install connector" / the token shown for a Docker connector
#
# NEVER commit the real .env — it is a credential. `.env` is listed in
# .gitignore for this reason.

TUNNEL_TOKEN=replace-me-with-your-cloudflare-tunnel-token
